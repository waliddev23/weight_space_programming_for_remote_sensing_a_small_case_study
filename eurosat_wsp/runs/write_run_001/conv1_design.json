 "design_rationales": {
  "filter_0": "[f00_VARI_smooth] Smoothed VARI (2G-R-B) over a 3x3 Gaussian: broad response to any green vegetation (Forest, Pasture, Herbaceous, crops) and negative on soil/urban.",
  "filter_1": "[f01_GR_centre] Pixel-level green-over-red excess with mild smoothing: sharper chlorophyll detector that separates bright Pasture/crop green from reddish bare fields.",
  "filter_2": "[f02_VARI_edge] Laplacian applied to the VARI colour direction: fires on boundaries of vegetation patches (field edges, forest borders, tree crowns).",
  "filter_3": "[f03_dark_green] Dark-and-green detector: negative smoothed luminance plus a green term. Forest is dark green; Pasture is bright green; urban is bright, so this orders Forest > Pasture > urban.",
  "filter_4": "[f04_BR_smooth] Smoothed blue-minus-red: water reflects blue and absorbs red; positive on River/SeaLake, negative on roofs and soil.",
  "filter_5": "[f05_blue_dark] Blue dominance combined with low brightness: deep/clear water (SeaLake) is dark and blue-tinted, distinguishing it from bright blue-grey industrial roofs.",
  "filter_6": "[f06_blue_texture] Centre-surround on the blue/green channels: small on smooth water surfaces, large on ripples, shorelines and river banks; separates River (textured, banked) from SeaLake (flat).",
  "filter_7": "[f07_sobel_x] Luminance Sobel-x: vertical edges of roads, building walls and lot boundaries (Highway, Industrial).",
  "filter_8": "[f08_sobel_y] Luminance Sobel-y: horizontal edges of roads and building rows.",
  "filter_9": "[f09_diag45] Luminance 45-degree edge detector for oblique roads and plot boundaries.",
  "filter_10": "[f10_diag135] Luminance 135-degree edge detector (complements filter 9 so any road orientation is covered).",
  "filter_11": "[f11_hline] Horizontal ridge detector (bright row between dark rows) with a small green-red term: periodic crop rows and furrows of Annual/Permanent Crop.",
  "filter_12": "[f12_vline] Vertical ridge detector, the 90-degree partner of filter 11 for crop rows and tree lines in orchards.",
  "filter_13": "[f13_dline] Diagonal ridge detector with a red-brown term: diagonal furrows, ploughed-soil stripes and vineyard rows (Permanent Crop).",
  "filter_14": "[f14_spot] Luminance centre-surround spot detector with a red-brown bias: bright isolated roofs on darker streets; dense Residential areas produce many such spots.",
  "filter_15": "[f15_corner] Corner detector (bright quadrant vs rest) with a red-roof bias: building corners and rectangular footprints typical of Residential and Industrial blocks."
 }
